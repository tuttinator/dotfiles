###############################################################################
#  Z-shell configuration – Starship for iTerm2
###############################################################################

# ── Homebrew environment tweaks ──────────────────────────────────────────────
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_BUNDLE_FILE="$HOME/dotfiles/Brewfile"

# ── Colours ──────────────────────────────────────────────────────────────────
export COLORTERM=truecolor         # Advertise 24-bit colour to capable emulators

# ── Starship prompt ──────────────────────────────────────────────────────────
eval "$(starship init zsh)"

# ── History behaviour ────────────────────────────────────────────────────────
export HISTFILE=~/.zsh_history
export HISTSIZE=50000
export SAVEHIST=50000
setopt SHARE_HISTORY          # Share history across sessions (implies append + inc-append)
setopt HIST_IGNORE_ALL_DUPS   # Drop older duplicate commands
setopt HIST_IGNORE_SPACE      # Don't record commands starting with a space
setopt HIST_VERIFY            # Show expanded history before running (safer !!)
setopt HIST_REDUCE_BLANKS     # Trim superfluous whitespace before saving

# ── Completion system ────────────────────────────────────────────────────────
# Must run BEFORE plugins so `compdef` is defined when ohmyzsh plugins load it.
autoload -Uz compinit
compinit

# ── Z-init / zsh-plugin-manager ──────────────────────────────────────────────
# Prefer the static bundle generated by bootstrap.sh (faster startup);
# fall back to dynamic load for machines that haven't run bootstrap yet.
if [[ -f ~/.zsh_plugins.sh ]]; then
    source ~/.zsh_plugins.sh
else
    source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
    antidote load
fi

# fzf-tab: fuzzy completion with previews (loaded via zsh_plugins.txt,
# before autosuggestions/syntax-highlighting so it can wrap their widgets).
if (( $+functions[enable-fzf-tab] )); then
    zstyle ':completion:*:descriptions' format '[%d]'
    zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --icons --color=always $realpath'
    zstyle ':fzf-tab:*' switch-group ',' '.'
    enable-fzf-tab
fi

# The command-not-found plugin shells out to `brew which-formula`, which runs
# Homebrew's auto-update when the API cache is stale — ~5s on a typo.
if (( $+functions[homebrew_command_not_found_handle] )); then
    functions[_brew_cnf_handle]=$functions[homebrew_command_not_found_handle]
    homebrew_command_not_found_handle() { HOMEBREW_NO_AUTO_UPDATE=1 _brew_cnf_handle "$@" }
fi

# ── PATH (consolidated) ──────────────────────────────────────────────────────
typeset -U path   # dedupe PATH entries automatically
if [[ -x /opt/homebrew/bin/brew ]]; then
    homebrew_prefix="/opt/homebrew"
elif [[ -x /usr/local/bin/brew ]]; then
    homebrew_prefix="/usr/local"
fi

path=(
    ${homebrew_prefix:+$homebrew_prefix/bin}
    ${homebrew_prefix:+$homebrew_prefix/sbin}
    "$HOME/.local/bin"
    "$HOME/bin"
    "$HOME/.config/emacs/bin"
    "$HOME/.yarn/bin"
    "$HOME/.config/yarn/global/node_modules/.bin"
    "$HOME/.bun/bin"
    "$HOME/.lmstudio/bin"
    "$HOME/.antigravity/antigravity/bin"
    "$HOME/Library/Android/sdk/emulator"
    "$HOME/Library/Android/sdk/tools"
    "$HOME/Library/Android/sdk/tools/bin"
    "$HOME/Library/Android/sdk/platform-tools"
    "/opt/homebrew/share/google-cloud-sdk/bin"
    $path
)
unset homebrew_prefix

export ANDROID_HOME="$HOME/Library/Android/sdk"
export BUN_INSTALL="$HOME/.bun"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# ── Misc env vars ────────────────────────────────────────────────────────────
COREPACK_ENABLE_AUTO_PIN=0
export EDITOR=nvim
export VISUAL=nvim
export MANPAGER="sh -c 'col -bx | bat -l man -p'"   # bat-powered man pages
export BAT_THEME="Monokai Extended"

# ── fzf (fd-backed, bat/eza previews) ────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :500 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons --color=always {} | head -200'"

# ── Tool integrations ────────────────────────────────────────────────────────
eval "$(/opt/homebrew/bin/mise activate zsh)"
eval "$(atuin init zsh --disable-up-arrow)"
# First up press → recall last command; second up press → atuin search
_atuin_smart_up() {
  if [[ "$LASTWIDGET" == "_atuin_smart_up" && -n "$BUFFER" ]]; then
    zle _atuin_search_widget
  else
    zle up-line-or-history
  fi
}
zle -N _atuin_smart_up
bindkey '^[[A' _atuin_smart_up   # Up arrow
bindkey '^[OA' _atuin_smart_up   # Up arrow (application mode)

# Alt-E: turn the typed line ("find logs over 1GB") into a command with aichat.
# Based on aichat's shell integration; the OpenAI key comes from llm's store.
export AICHAT_CONFIG_DIR="$HOME/.config/aichat"
_aichat_zsh() {
  [[ -n "$BUFFER" ]] || return
  local _old=$BUFFER
  BUFFER+="⌛"
  zle -I && zle redisplay
  BUFFER=$(OPENAI_API_KEY=$(llm keys get openai 2>/dev/null) aichat -e "$_old")
  [[ -n "$BUFFER" ]] || BUFFER=$_old
  zle end-of-line
}
zle -N _aichat_zsh
bindkey '^[e' _aichat_zsh

# Typing a "# comment" and pausing for a second shows the ⌥E hint under the
# prompt. One `sleep` timer at a time, and only while the line is a comment.
zmodload zsh/datetime
typeset -g _ai_hint_fd= _ai_hint_buf= _ai_hint_last=0
_ai_hint_timer() {
  exec {_ai_hint_fd}< <(sleep $1)
  zle -F -w $_ai_hint_fd _ai_hint_fire
}
_ai_hint_arm() {
  [[ $BUFFER == $_ai_hint_buf ]] && return   # a redraw, not an edit
  _ai_hint_buf=$BUFFER _ai_hint_last=$EPOCHREALTIME
  [[ $BUFFER =~ '^[[:space:]]*#' && -z $_ai_hint_fd ]] && _ai_hint_timer 1
}
_ai_hint_fire() {
  local fd=$1
  zle -F $fd; exec {fd}<&-; _ai_hint_fd=
  [[ $BUFFER =~ '^[[:space:]]*#' ]] || return
  local idle=$(( EPOCHREALTIME - _ai_hint_last ))
  if (( idle < 1 )); then
    _ai_hint_timer $(( 1 - idle ))
  else
    zle -M "⌥E  turn this comment into a command"
  fi
}
zle -N _ai_hint_arm
zle -N _ai_hint_fire
autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-pre-redraw _ai_hint_arm
eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"

# ── Aliases ──────────────────────────────────────────────────────────────────
# eza (modern ls replacement)
alias ls='eza --icons --group-directories-first'
alias ll='eza -l --icons --git --group-directories-first'
alias la='eza -la --icons --git --group-directories-first'
alias lt='eza --tree --level=2 --icons --git-ignore'

# ── Functions ────────────────────────────────────────────────────────────────
# Review a GitHub PR in Emacs (pr-review).  `prr` = current branch's PR,
# `prr 113` = PR 113 of this repo, `prr <url>` = any PR.  Opens in this
# terminal via the running Emacs server, or starts a fresh Emacs.
prr() {
  local url=$1
  if [[ -z $url || $url == <-> ]]; then
    url=$(gh pr view $url --json url --jq .url) || return
  fi
  local form="(pr-review \"$url\")"
  emacsclient -t --eval "$form" 2>/dev/null || emacs -nw --eval "$form"
}

# ── Deferred (non-critical, speeds up shell startup) ─────────────────────────
# fzf's zsh script binds Tab and Ctrl-R itself; keep Ctrl-T/Alt-C from it but
# hand Tab back to fzf-tab and Ctrl-R back to atuin.
_load_fzf() {
    [[ -f ~/.fzf.zsh ]] || return
    source ~/.fzf.zsh
    (( $+widgets[fzf-tab-complete] )) && bindkey '^I' fzf-tab-complete
    (( $+widgets[atuin-search] )) && bindkey '^R' atuin-search
}
if (( $+functions[zsh-defer] )); then
    zsh-defer source "${HOME}/.iterm2_shell_integration.zsh" 2>/dev/null
    zsh-defer _load_fzf
else
    [[ -f "${HOME}/.iterm2_shell_integration.zsh" ]] && source "${HOME}/.iterm2_shell_integration.zsh"
    _load_fzf
fi
